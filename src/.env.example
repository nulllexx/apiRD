# Required
JWT_SECRET=your_jwt_secret_here

# Server
PORT=5000

# Database (MariaDB)
#
# In production, DB_HOST, DB_USER, DB_PASSWORD and DB_NAME are NOT stored here.
# They are injected at deploy time from GitHub Actions repository secrets
# (see .github/workflows/deploy.yml) into docker-compose's environment block.
# For local dev, set them to your own local database values below.
DB_HOST=your_db_host_here
DB_PORT=3306
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# File paths
UPLOAD_TMP=data/uploads
STORAGE_BASE=/usr/share/nginx/html/raindrippy/projects/public
PUBLIC_URL_BASE=/raindrippy/projects/public
MINECRAFT_SKIN_PATH=/mcserver/plugins/SkinsRestorer/skins
AUTHED_PLAYERS_PATH=/mcserver/authedPlayers.json
PLAYER_COUNT_PATH=/mcserver/plrCount.json
SERVER_PROPERTIES_PATH=/mcserver/server.properties
MINECRAFT_LOG_PATH=/mcserver/logs/latest.log
# The container's raw stdout, captured by having start.sh tee its output here.
# Carries JVM crashes and start-up errors that never reach latest.log.
MINECRAFT_STDOUT_PATH=/mcserver/logs/console.log
UPLOAD_LOGS_PATH=/home/useradmin/api/uploadlogs.json
CONTENT_PATH=content
SEASONS_PATH=/usr/share/nginx/html/raindrippy/content
# "End season" (permission season.end) reads the season number, theme,
# Minecraft version and main world from SEASON_INFO_PATH (written by
# ServerSideUtils), stops the server, zips the main world and mods into
# SEASONS_PATH/Season_<n>.zip, writes the season's record to
# ARCHIVES_DIR/Season_<n>.json (created if missing), sets the new seed in
# SERVER_PROPERTIES_PATH, writes the next season's number and theme to
# SEASON_OVERRIDE_PATH (read by ServerSideUtils on start-up), deletes only the
# main world folders, and starts the server. Records can be created and
# edited by hand with season.archives.
SEASON_INFO_PATH=/mcserver/plugins/ServerSideUtils/season.json
SEASON_OVERRIDE_PATH=/mcserver/plugins/ServerSideUtils/season-override.json
ARCHIVES_DIR=/usr/share/nginx/html/archives
MEDIA_PATH=C:/server/media

RCON_PASSWORD=your_rcon_password_here
RCON_ADDRESS=127.0.0.1:29875

CONTROL_DIR=/control

# Admin panel file browser (Minecraft Server > Files, permission console.files).
# Read-only, confined to this directory. Credential stores (authedPlayers.json,
# .rcon-cli.*, key files...) are never served, and secret-looking config values
# are masked. Add more patterns to refuse, comma-separated: a bare name matches
# anywhere, a path matches from the server root, `*` stays within one folder.
MINECRAFT_SERVER_DIR=/mcserver
# SERVER_FILES_DENY=plugins/LuckPerms,backups
#
# Editing (console.edit) and uploads (console.upload). The previous version of
# every overwritten file is kept here, newest 20 per file. Must be OUTSIDE the
# server directory (backups are unmasked); writes are refused otherwise. Set it
# to an empty value to turn editing and uploads off entirely.
SERVER_FILES_BACKUP_DIR=/home/useradmin/api/mainapi/data/file-backups
# Extra paths that stay read-only, on top of the built-in list (code folders,
# logs, ops/whitelist/ban lists). Same pattern syntax as SERVER_FILES_DENY.
# SERVER_FILES_READONLY=plugins/LuckPerms,config/ftbranks
CONSOLE_BACKLOG_LINES=500

# CORS
CORS_ORIGIN=https://bakosmp.go.ro

# Router (optional — defaults to hardcoded hash)
# ROUTER_PASSWORD=your_router_password_hash

# Google OAuth (Sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
#
# In production, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are NOT stored here.
# They are injected at deploy time from GitHub Actions repository secrets
# (see .github/workflows/deploy.yml) into docker-compose's environment block.
# For local dev only, you may set them temporarily in your shell env.
GOOGLE_REDIRECT_URI=https://bakosmp.go.ro/api/auth/oauth/google/callback
# Frontend page that collects username + HWID for first-time Google sign-ups
OAUTH_SIGNUP_REDIRECT=https://bakosmp.go.ro/finish-signup
# Frontend page to land on after a successful OAuth sign-in
OAUTH_SUCCESS_REDIRECT=https://bakosmp.go.ro/dashboard

# Account emails (address confirmation, password reset links), sent through
# the Gmail API as one Google account. Email is off unless a refresh token,
# an OAuth client ID/secret and EMAIL_FROM are all set.
#
# Setup: enable the Gmail API in the Google Cloud project, then authorise the
# sending account once with the scope
# https://www.googleapis.com/auth/gmail.send (e.g. through the OAuth 2.0
# Playground, "Use your own OAuth credentials") and keep the refresh token.
# If the OAuth consent screen is in "Testing", Google expires refresh tokens
# after 7 days, so publish it (or use an Internal Workspace app).
#
# In production these are NOT stored here: they are injected at deploy time
# from the GitHub Actions repository secrets of the same names. The client
# ID/secret are optional and fall back to GOOGLE_CLIENT_ID/SECRET; the refresh
# token must have been issued to whichever client is used.
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=1//...
#
# The sender. Gmail sends as the authorised account, so this must be that
# address or one of its verified "Send mail as" aliases; anything else is
# rewritten to the account's own address.
EMAIL_FROM=RainDrippy <your-account@gmail.com>
# The website the links in emails point at (no trailing slash).
PUBLIC_SITE_URL=https://bakosmp.go.ro

# Logging (set to debug for verbose output)
RUST_LOG=info
